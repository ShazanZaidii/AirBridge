<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        AirBridge design tokens.
        Everything is keyed with an "AB." prefix and there are NO implicit styles, so windows owned by the
        input half (DisplayArrangementWindow) are unaffected unless they opt in.
        Icons: Segoe Fluent Icons (Windows 11) with Segoe MDL2 Assets fallback (Windows 10). No emoji.
    -->

    <!-- colours -->
    <Color x:Key="AB.C.Background">#0F0F11</Color>
    <Color x:Key="AB.C.Card">#CC1B1B1E</Color>
    <Color x:Key="AB.C.Muted">#27272B</Color>
    <Color x:Key="AB.C.Secondary">#34343A</Color>
    <Color x:Key="AB.C.Border">#45454C</Color>
    <Color x:Key="AB.C.Foreground">#F4F4F6</Color>
    <Color x:Key="AB.C.MutedForeground">#A1A1A8</Color>
    <Color x:Key="AB.C.Accent">#5B9DFF</Color>
    <Color x:Key="AB.C.OnAccent">#0F0F11</Color>
    <Color x:Key="AB.C.Destructive">#FF7A7A</Color>
    <Color x:Key="AB.C.Warning">#FFC53D</Color>

    <SolidColorBrush x:Key="AB.Background" Color="{StaticResource AB.C.Background}"/>
    <SolidColorBrush x:Key="AB.Card" Color="{StaticResource AB.C.Card}"/>
    <SolidColorBrush x:Key="AB.Muted" Color="{StaticResource AB.C.Muted}"/>
    <SolidColorBrush x:Key="AB.Secondary" Color="{StaticResource AB.C.Secondary}"/>
    <SolidColorBrush x:Key="AB.Border" Color="{StaticResource AB.C.Border}"/>
    <SolidColorBrush x:Key="AB.Foreground" Color="{StaticResource AB.C.Foreground}"/>
    <SolidColorBrush x:Key="AB.MutedForeground" Color="{StaticResource AB.C.MutedForeground}"/>
    <SolidColorBrush x:Key="AB.Accent" Color="{StaticResource AB.C.Accent}"/>
    <SolidColorBrush x:Key="AB.AccentSoft" Color="#265B9DFF"/>
    <SolidColorBrush x:Key="AB.OnAccent" Color="{StaticResource AB.C.OnAccent}"/>
    <SolidColorBrush x:Key="AB.Destructive" Color="{StaticResource AB.C.Destructive}"/>
    <SolidColorBrush x:Key="AB.Warning" Color="{StaticResource AB.C.Warning}"/>
    <SolidColorBrush x:Key="AB.HoverOverlay" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="AB.PressOverlay" Color="#24FFFFFF"/>

    <!-- the one small splash of green: a connected dot. Never a fill, never text. -->
    <Color x:Key="AB.C.Success">#46C38A</Color>
    <SolidColorBrush x:Key="AB.Success" Color="{StaticResource AB.C.Success}"/>
    <!-- white primary button, as on the phone and the Mac -->
    <SolidColorBrush x:Key="AB.Primary" Color="#F4F4F6"/>
    <SolidColorBrush x:Key="AB.RowHover" Color="#0FFFFFFF"/>

    <!-- type -->
    <FontFamily x:Key="AB.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="AB.DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="AB.MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="AB.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- glyphs (Segoe MDL2 / Fluent code points) -->
    <sys:String x:Key="AB.G.Phone">&#xE8EA;</sys:String>
    <sys:String x:Key="AB.G.Laptop">&#xE7F8;</sys:String>
    <sys:String x:Key="AB.G.Desktop">&#xE977;</sys:String>
    <sys:String x:Key="AB.G.Link">&#xE71B;</sys:String>
    <sys:String x:Key="AB.G.Display">&#xE7F4;</sys:String>
    <sys:String x:Key="AB.G.Clipboard">&#xE77F;</sys:String>
    <sys:String x:Key="AB.G.Power">&#xE7E8;</sys:String>
    <sys:String x:Key="AB.G.Close">&#xE8BB;</sys:String>
    <sys:String x:Key="AB.G.Lock">&#xE72E;</sys:String>
    <sys:String x:Key="AB.G.Mouse">&#xE962;</sys:String>

    <!-- focus ring: visible for keyboard users -->
    <Style x:Key="AB.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="9" RadiusY="9" Stroke="White" StrokeThickness="2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Base button: rounded, overlay hover/press with 150 ms fades, pointer cursor, focus ring. -->
    <Style x:Key="AB.Button" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AB.Font}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AB.Foreground}"/>
        <Setter Property="Background" Value="{StaticResource AB.Muted}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AB.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
                        <Border x:Name="Hover" Background="{StaticResource AB.HoverOverlay}" CornerRadius="8" Opacity="0"/>
                        <Border x:Name="Press" Background="{StaticResource AB.PressOverlay}" CornerRadius="8" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/></Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Press" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AB.Button.Primary" TargetType="Button" BasedOn="{StaticResource AB.Button}">
        <Setter Property="Background" Value="{StaticResource AB.Primary}"/>
        <Setter Property="Foreground" Value="{StaticResource AB.OnAccent}"/>
    </Style>

    <Style x:Key="AB.Button.Secondary" TargetType="Button" BasedOn="{StaticResource AB.Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource AB.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Full-width list action: glyph + label, left aligned. -->
    <Style x:Key="AB.Button.Ghost" TargetType="Button" BasedOn="{StaticResource AB.Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <!-- Square icon-only button; always give it ToolTip + AutomationProperties.Name. -->
    <Style x:Key="AB.Button.Icon" TargetType="Button" BasedOn="{StaticResource AB.Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource AB.Icons}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource AB.MutedForeground}"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="AB.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AB.Icons}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource AB.Foreground}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="AB.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AB.Font}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource AB.Foreground}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="AB.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource AB.Text}">
        <Setter Property="FontFamily" Value="{StaticResource AB.DisplayFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="AB.Text.Section" TargetType="TextBlock" BasedOn="{StaticResource AB.Text}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AB.MutedForeground}"/>
        <Setter Property="Margin" Value="2,0,0,6"/>
    </Style>
    <Style x:Key="AB.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource AB.Text}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource AB.MutedForeground}"/>
    </Style>
    <Style x:Key="AB.Text.Digits" TargetType="TextBlock" BasedOn="{StaticResource AB.Text}">
        <Setter Property="FontFamily" Value="{StaticResource AB.MonoFont}"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style x:Key="AB.TextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AB.Font}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource AB.Foreground}"/>
        <Setter Property="Background" Value="{StaticResource AB.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AB.Border}"/>
        <Setter Property="CaretBrush" Value="{StaticResource AB.Foreground}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AB.Accent}"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AB.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin accent progress bar for transfers. -->
    <Style x:Key="AB.Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Foreground" Value="{StaticResource AB.Accent}"/>
        <Setter Property="Background" Value="{StaticResource AB.Muted}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
    </Style>

    <!-- Dialog content area. The windows now use the normal (dark) title bar instead of a transparent borderless
         shape, which WPF draws in software and which costs memory on every redraw. -->
    <Style x:Key="AB.Window.Card" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <!-- Action tile: icon over a short label (the Mac's ActionTile). -->
    <Style x:Key="AB.Tile" TargetType="Button" BasedOn="{StaticResource AB.Button}">
        <Setter Property="Background" Value="{StaticResource AB.Card}"/>
        <Setter Property="Padding" Value="4,10"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="64"/>
    </Style>

    <!-- A full-width row that is one button: icon tile, two lines, a pencil. -->
    <Style x:Key="AB.Button.Row" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AB.Font}"/>
        <Setter Property="Foreground" Value="{StaticResource AB.Foreground}"/>
        <Setter Property="Background" Value="{StaticResource AB.Card}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AB.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12"/>
                        <Border x:Name="Hover" Background="{StaticResource AB.RowHover}" CornerRadius="12" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small rounded pill button for secondary tools. -->
    <Style x:Key="AB.Button.Pill" TargetType="Button" BasedOn="{StaticResource AB.Button}">
        <Setter Property="Background" Value="{StaticResource AB.Card}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>

    <!-- A quiet text link button (no box). -->
    <Style x:Key="AB.Button.Link" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AB.Font}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource AB.MutedForeground}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AB.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AB.RowHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource AB.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A switch (CheckBox look): a pill with a sliding knob. White when on. -->
    <Style x:Key="AB.Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AB.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="40" Height="22" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="11" Background="{StaticResource AB.Secondary}"/>
                        <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{StaticResource AB.MutedForeground}" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AB.Primary}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource AB.OnAccent}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin dark scrollbar: the default grey one looks wrong on graphite. -->
    <Style x:Key="AB.ScrollViewer" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>
</ResourceDictionary>
