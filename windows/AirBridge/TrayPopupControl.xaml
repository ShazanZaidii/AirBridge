<UserControl x:Class="AirBridge.TrayPopupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Width="300">
    <UserControl.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#3A3A3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#48484A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#282828" CornerRadius="12" Padding="16"
            BorderBrush="#3A3A3C" BorderThickness="1"
            Margin="10" AllowDrop="True" Drop="Border_Drop">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.5" Direction="270" ShadowDepth="4"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="AirBridge" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="DeviceNameText" Foreground="#A0A0A5" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,12"/>

            <Border Background="White" CornerRadius="8" Padding="8" HorizontalAlignment="Center">
                <Grid Width="150" Height="150">
                    <Image x:Name="QrCodeImage" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <TextBlock x:Name="QrPlaceholder" Text="Starting…" Foreground="#808080" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                </Grid>
            </Border>
            <TextBlock Text="Scan with the AirBridge app to pair" Foreground="#A0A0A5" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,8"/>

            <TextBlock Text="or enter this code on the other device" Foreground="#A0A0A5" FontSize="11" HorizontalAlignment="Center"/>
            <TextBlock x:Name="CodeText" Foreground="White" FontSize="24" FontFamily="Consolas" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <TextBlock x:Name="AddressText" Foreground="#707075" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <Separator Background="#404040" Margin="-16,0,-16,8"/>
            <TextBlock Text="Paired devices" Foreground="#A0A0A5" FontSize="11" Margin="0,0,0,6"/>
            <StackPanel x:Name="PeersPanel" Margin="0,0,0,10"/>

            <Button Content="Connect to a Mac / PC…" Style="{StaticResource FlatButton}" Click="OpenHostDiscovery_Click"/>
            <Button Content="Display Arrangement…" Style="{StaticResource FlatButton}" Click="OpenArrangement_Click"/>
            <Button Content="Clipboard Filters…" Style="{StaticResource FlatButton}" Click="OpenFilters_Click" Margin="0,0,0,12"/>

            <Separator Background="#404040" Margin="-16,0,-16,8"/>
            <Button Content="Quit" Style="{StaticResource FlatButton}" Width="70" Height="28" Margin="0" Click="Quit_Click"/>
        </StackPanel>
    </Border>
</UserControl>
