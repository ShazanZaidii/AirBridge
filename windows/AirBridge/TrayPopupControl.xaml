<UserControl x:Class="AirBridge.TrayPopupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Width="260">

    <Border Background="#282828" CornerRadius="12" Padding="16" 
            BorderBrush="#3A3A3C" BorderThickness="1" 
            Margin="10" AllowDrop="True" Drop="Border_Drop">

        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.5" Direction="270" ShadowDepth="4"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="AirBridge Server" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>

            <Border x:Name="DeviceDropdownBorder" Background="#333333" CornerRadius="6" Margin="0,10,0,16" Height="28" Padding="10,0" 
                    MouseLeftButtonDown="DeviceDropdown_Click" Cursor="Arrow">
                <Grid>
                    <TextBlock x:Name="DeviceDropdownText" Text="Waiting for connection..." Foreground="#FF9F0A" 
                               VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13"/>

                    <Path x:Name="DeviceDropdownChevron" Visibility="Collapsed" Data="M 0 0 L 4 4 L 8 0" 
                          Stroke="#A0A0A5" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
                </Grid>
            </Border>

            <Popup x:Name="DevicePopup" AllowsTransparency="True" StaysOpen="False" PlacementTarget="{Binding ElementName=DeviceDropdownBorder}" Placement="Bottom">
                <Border Background="#282828" BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,4,0,0">
                    <StackPanel x:Name="DevicePopupPanel"/>
                </Border>
            </Popup>

            <Border Background="White" CornerRadius="8" Padding="8" HorizontalAlignment="Center">
                <Image x:Name="QrCodeImage" Width="140" Height="140" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>

            <TextBlock x:Name="ScanPromptText" Text="Scan to add device" Foreground="#A0A0A5" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,16"/>

            <Button Content="Connect to another Laptop..." Height="30" Background="#3A3A3C" Foreground="White" BorderThickness="0" 
                    Click="OpenHostDiscovery_Click" Margin="0,0,0,8" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Display Arrangement..." Height="30" Background="#3A3A3C" Foreground="White" BorderThickness="0" 
                    Click="OpenArrangement_Click" Margin="0,0,0,8" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Clipboard Filters..." Height="30" Background="#3A3A3C" Foreground="White" BorderThickness="0" 
                    Click="OpenFilters_Click" Margin="0,0,0,16" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Separator Background="#404040" Margin="-16,0,-16,8"/>

            <Button Content="Quit" Height="28" Background="#3A3A3C" Foreground="White" BorderThickness="0" 
                    Click="Quit_Click" Cursor="Hand" Width="60" HorizontalAlignment="Center">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Border>
</UserControl>