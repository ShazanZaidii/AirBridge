<UserControl x:Class="AirBridge.TrayPopupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" AllowDrop="True" Drop="Border_Drop">
    <StackPanel Margin="16">

        <!-- header -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AB.Muted}">
                <TextBlock Style="{StaticResource AB.Glyph}" Text="{StaticResource AB.G.Link}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource AB.Text}" Text="AirBridge" FontSize="15" FontWeight="SemiBold"
                           MouseLeftButtonUp="Title_MouseLeftButtonUp"/>
                <TextBlock x:Name="DeviceNameText" Style="{StaticResource AB.Text.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="StatusPill" CornerRadius="10" Padding="8,3" Background="{StaticResource AB.Card}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource AB.MutedForeground}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Style="{StaticResource AB.Text.Caption}" Margin="6,0,0,0" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Border>
                <Button x:Name="OpenWindowButton" Style="{StaticResource AB.Button.Icon}" Content="&#xE8A7;" Margin="4,0,0,0" Width="32" Height="32" MinHeight="32"
                        ToolTip="Open in a window" AutomationProperties.Name="Open in a window" Click="OpenWindow_Click"/>
            </StackPanel>
        </Grid>

        <!-- this PC's name as other devices see it: the whole row is the button, the pencil says so -->
        <Grid Margin="0,0,0,12">
            <Button x:Name="RenameRow" Style="{StaticResource AB.Button.Row}" Click="RenameRow_Click" ToolTip="Rename this PC"
                    AutomationProperties.Name="Rename this PC">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AB.Muted}">
                        <TextBlock Style="{StaticResource AB.Glyph}" Text="{StaticResource AB.G.Laptop}" FontSize="13"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RenameName" Style="{StaticResource AB.Text}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Style="{StaticResource AB.Text.Caption}" FontSize="11" Text="How your other devices see this PC"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource AB.Glyph}" Text="&#xE70F;" FontSize="13" Foreground="{StaticResource AB.MutedForeground}"/>
                </Grid>
            </Button>
            <Border x:Name="RenameEdit" Visibility="Collapsed" Background="{StaticResource AB.Card}" CornerRadius="12" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NameBox" Style="{StaticResource AB.TextBox}" MinHeight="32" MaxLength="40" KeyDown="NameBox_KeyDown"
                             AutomationProperties.Name="New name for this PC"/>
                    <Button Grid.Column="1" Content="Save" Style="{StaticResource AB.Button.Primary}" Margin="8,0,0,0" MinHeight="32" Padding="12,0" Click="NameSave_Click"/>
                    <Button Grid.Column="2" Content="Cancel" Style="{StaticResource AB.Button.Secondary}" Margin="6,0,0,0" MinHeight="32" Padding="10,0" Click="NameCancel_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- AirWeb keeps going after its window closes: say so here and let it be stopped from here too -->
        <Border x:Name="AirWebRow" Visibility="Collapsed" Background="{StaticResource AB.Card}" CornerRadius="12" Padding="12,8,8,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource AB.Glyph}" Text="&#xE774;" FontSize="15" Margin="0,0,10,0" Foreground="{StaticResource AB.MutedForeground}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AB.Text}" Text="AirWeb is running"/>
                    <TextBlock x:Name="AirWebRowSub" Style="{StaticResource AB.Text.Caption}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Open" Style="{StaticResource AB.Button.Secondary}" MinHeight="30" Padding="12,0" Click="AirWeb_Click" AutomationProperties.Name="Open AirWeb"/>
                    <Button Content="Stop" Style="{StaticResource AB.Button.Primary}" MinHeight="30" Padding="12,0" Margin="6,0,0,0" Click="StopAirWeb_Click" AutomationProperties.Name="Stop AirWeb"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- phones can't reach this PC: the firewall (shown only when it is the likely cause) -->
        <Border x:Name="FirewallBand" Visibility="Collapsed" Background="{StaticResource AB.Card}" CornerRadius="12" Margin="0,0,0,12"
                BorderBrush="{StaticResource AB.Warning}" BorderThickness="3,0,0,0" Padding="12,10">
            <StackPanel>
                <TextBlock Style="{StaticResource AB.Text}" FontWeight="SemiBold" Text="Other devices may not find this PC"/>
                <TextBlock Style="{StaticResource AB.Text.Caption}" Margin="0,2,0,8" Text="Windows Firewall isn't set up for AirBridge yet."/>
                <Button Content="Fix it" Style="{StaticResource AB.Button.Secondary}" HorizontalAlignment="Left" Padding="14,0" Click="OpenNetworkCheck_Click"
                        AutomationProperties.Name="Open the network check to fix the firewall"/>
            </StackPanel>
        </Border>

        <!-- control / lease status from the input half -->
        <Border x:Name="ControlBand" Visibility="Collapsed" Background="{StaticResource AB.Card}" CornerRadius="12" Margin="0,0,0,12"
                BorderBrush="{StaticResource AB.Accent}" BorderThickness="3,0,0,0" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource AB.Glyph}" Text="{StaticResource AB.G.Mouse}" Foreground="{StaticResource AB.Accent}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                <TextBlock Grid.Column="1" x:Name="ControlText" Style="{StaticResource AB.Text}" AutomationProperties.LiveSetting="Polite"/>
            </Grid>
        </Border>

        <!-- devices -->
        <TextBlock Style="{StaticResource AB.Text.Section}" Text="Devices"/>
        <StackPanel x:Name="PeersPanel" Margin="0,0,0,12"/>

        <!-- transfers (only while any) -->
        <StackPanel x:Name="TransfersSection" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource AB.Text.Section}" Text="Transfers"/>
            <StackPanel x:Name="TransfersPanel"/>
        </StackPanel>

        <!-- the few things people do most, one click each -->
        <UniformGrid Columns="4" Margin="0,0,0,10">
            <Button x:Name="AirWebTile" Style="{StaticResource AB.Tile}" Margin="0,0,6,0" Click="AirWeb_Click"
                    ToolTip="Send or receive files with a phone or computer that doesn't have AirBridge, through its browser"
                    AutomationProperties.Name="AirWeb">
                <StackPanel>
                    <Grid HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource AB.Glyph}" Text="&#xE774;" FontSize="18"/>
                        <Ellipse x:Name="AirWebDot" Width="7" Height="7" Fill="{StaticResource AB.Success}" Visibility="Collapsed"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-8,0"/>
                    </Grid>
                    <TextBlock Style="{StaticResource AB.Text}" Text="AirWeb" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="SendTile" Style="{StaticResource AB.Tile}" Margin="0,0,6,0" Click="SendFiles_Click"
                    ToolTip="Pick files and send them to a device" AutomationProperties.Name="Send files">
                <StackPanel>
                    <TextBlock Style="{StaticResource AB.Glyph}" Text="&#xE898;" FontSize="18"/>
                    <TextBlock Style="{StaticResource AB.Text}" Text="Send" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="PhoneNotifsButton" Style="{StaticResource AB.Tile}" Margin="0,0,6,0" Click="OpenPhoneNotifs_Click"
                    ToolTip="Your phone's notifications" AutomationProperties.Name="Phone notifications">
                <StackPanel>
                    <TextBlock Style="{StaticResource AB.Glyph}" Text="&#xEA8F;" FontSize="18"/>
                    <TextBlock x:Name="PhoneNotifsText" Style="{StaticResource AB.Text}" Text="Notifications" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="AddTile" Style="{StaticResource AB.Tile}" Click="AddDevice_Click"
                    ToolTip="Pair a new phone or computer" AutomationProperties.Name="Add device">
                <StackPanel>
                    <TextBlock Style="{StaticResource AB.Glyph}" Text="&#xE710;" FontSize="18"/>
                    <TextBlock Style="{StaticResource AB.Text}" Text="Add device" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- add a device: opens in place (and is open when nothing is paired yet) -->
        <Border x:Name="AddPanel" Visibility="Collapsed" Background="{StaticResource AB.Card}" CornerRadius="14" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="White" CornerRadius="10" Padding="6">
                        <Grid Width="108" Height="108">
                            <Image x:Name="QrCodeImage" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   AutomationProperties.Name="Pairing QR code"/>
                            <TextBlock x:Name="QrPlaceholder" Text="Starting…" Foreground="#45454C" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource AB.Text}" FontWeight="SemiBold" Text="Pair from your phone"/>
                        <TextBlock Style="{StaticResource AB.Text.Caption}" Margin="0,4,0,0"
                                   Text="Open AirBridge on your phone and scan this code. Or pick this PC in the phone's list and confirm the 6-digit code."/>
                        <TextBlock x:Name="AddressText" Style="{StaticResource AB.Text.Caption}" FontFamily="{StaticResource AB.MonoFont}" Margin="0,6,0,0" TextWrapping="NoWrap"/>
                        <TextBlock x:Name="LockedText" Style="{StaticResource AB.Text.Caption}" Foreground="{StaticResource AB.Warning}" Margin="0,6,0,0" Visibility="Collapsed"
                                   Text="Pairing paused for a minute after failed attempts."/>
                    </StackPanel>
                </Grid>
                <Button Style="{StaticResource AB.Button.Pill}" Margin="0,12,0,0" Click="OpenHostDiscovery_Click" AutomationProperties.Name="Connect to a Mac or PC">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource AB.Glyph}" Text="{StaticResource AB.G.Link}" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource AB.Text}" Text="Connect to a Mac or PC…" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- tools -->
        <UniformGrid Columns="2" Margin="0,0,0,6">
            <Button Style="{StaticResource AB.Button.Pill}" Margin="0,0,4,0" Click="OpenArrangement_Click" ToolTip="Arrange where your devices sit around this screen"
                    AutomationProperties.Name="Display arrangement">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource AB.Glyph}" Text="{StaticResource AB.G.Display}" FontSize="13" Margin="0,0,8,0"/>
                    <TextBlock Style="{StaticResource AB.Text}" Text="Displays" FontSize="12"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource AB.Button.Pill}" Margin="4,0,0,0" Click="OpenFilters_Click" ToolTip="Choose what clipboard content is shared"
                    AutomationProperties.Name="Clipboard filters">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource AB.Glyph}" Text="{StaticResource AB.G.Clipboard}" FontSize="13" Margin="0,0,8,0"/>
                    <TextBlock Style="{StaticResource AB.Text}" Text="Clipboard filters" FontSize="12"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- settings -->
        <Button x:Name="SettingsToggle" Style="{StaticResource AB.Button.Link}" Click="SettingsToggle_Click" HorizontalAlignment="Left" Margin="-6,4,0,0"
                AutomationProperties.Name="Settings">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource AB.Text.Caption}" Text="Settings" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                <TextBlock x:Name="SettingsChevron" Style="{StaticResource AB.Glyph}" FontSize="10" Margin="6,1,0,0" Text="&#xE70D;"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </StackPanel>
        </Button>
        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Margin="0,6,0,0">

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Style="{StaticResource AB.Text}" Text="Drop shelf"/>
                    <TextBlock Style="{StaticResource AB.Text.Caption}" Text="A small target above the tray: drop files on it to send"/></StackPanel>
                <CheckBox Grid.Column="1" x:Name="DropShelfSwitch" Style="{StaticResource AB.Switch}" Click="ToggleDropShelf_Click" VerticalAlignment="Center"
                          AutomationProperties.Name="Drop shelf"/>
            </Grid>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Style="{StaticResource AB.Text}" Text="Tidy up finished transfers"/>
                    <TextBlock Style="{StaticResource AB.Text.Caption}" Text="Hide their cards after 5 seconds"/></StackPanel>
                <CheckBox Grid.Column="1" x:Name="AutoHideSwitch" Style="{StaticResource AB.Switch}" Click="ToggleCardAutoHide_Click" VerticalAlignment="Center"
                          AutomationProperties.Name="Tidy up finished transfers"/>
            </Grid>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Style="{StaticResource AB.Text}" Text="Phone notifications"/>
                    <TextBlock Style="{StaticResource AB.Text.Caption}" Text="Show them on this PC"/></StackPanel>
                <CheckBox Grid.Column="1" x:Name="NotifsSwitch" Style="{StaticResource AB.Switch}" Click="TogglePhoneNotifs_Click" VerticalAlignment="Center"
                          AutomationProperties.Name="Phone notifications"/>
            </Grid>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Style="{StaticResource AB.Text}" Text="Phone calls"/>
                    <TextBlock Style="{StaticResource AB.Text.Caption}" Text="See and answer calls here"/></StackPanel>
                <CheckBox Grid.Column="1" x:Name="CallsSwitch" Style="{StaticResource AB.Switch}" Click="TogglePhoneCalls_Click" VerticalAlignment="Center"
                          AutomationProperties.Name="Phone calls"/>
            </Grid>
            <Grid x:Name="RingRow" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Style="{StaticResource AB.Text}" Text="Ring on this PC"/>
                    <TextBlock Style="{StaticResource AB.Text.Caption}" Text="Smart rings where you are, and keeps the phone quiet"/></StackPanel>
                <Button Grid.Column="1" x:Name="RingModeButton" Style="{StaticResource AB.Button.Pill}" MinWidth="76" Click="RingMode_Click"
                        AutomationProperties.Name="Ring on this PC"
                        ToolTip="Smart: rings when you're using this PC (then your phone stays quiet) or your phone is next to it.">
                    <TextBlock x:Name="RingModeText" Style="{StaticResource AB.Text}" Text="Smart" FontSize="12"/>
                </Button>
            </Grid>
            <Grid x:Name="StartupRow" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Style="{StaticResource AB.Text}" Text="Start with Windows"/>
                    <TextBlock Style="{StaticResource AB.Text.Caption}" Text="So your phone can always find this PC"/></StackPanel>
                <CheckBox Grid.Column="1" x:Name="StartupSwitch" Style="{StaticResource AB.Switch}" Click="ToggleStartup_Click" VerticalAlignment="Center"
                          AutomationProperties.Name="Start with Windows"/>
            </Grid>
            <Grid x:Name="GlassRow" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Style="{StaticResource AB.Text}" Text="Frosted glass"/>
                    <TextBlock Style="{StaticResource AB.Text.Caption}" Text="See-through windows. Turn off on a slow PC. Applies to windows you open next"/></StackPanel>
                <CheckBox Grid.Column="1" x:Name="GlassSwitch" Style="{StaticResource AB.Switch}" Click="ToggleGlass_Click" VerticalAlignment="Center"
                          AutomationProperties.Name="Frosted glass"/>
            </Grid>
            <Button Style="{StaticResource AB.Button.Pill}" Margin="0,0,0,6" Click="OpenNetworkCheck_Click" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Can't find a device? Network check">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource AB.Glyph}" Text="&#xE839;" FontSize="13" Margin="0,0,8,0"/>
                    <TextBlock Style="{StaticResource AB.Text}" Text="Can't find a device?" FontSize="12"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- footer -->
        <Rectangle Height="1" Fill="{StaticResource AB.Secondary}" Margin="0,10,0,6"/>
        <Button Style="{StaticResource AB.Button.Link}" Click="Quit_Click" HorizontalAlignment="Left" Margin="-6,0,0,0" AutomationProperties.Name="Quit AirBridge">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource AB.Glyph}" Text="{StaticResource AB.G.Power}" FontSize="12" Margin="0,0,8,0"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                <TextBlock Style="{StaticResource AB.Text.Caption}" Text="Quit AirBridge" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
