<Window x:Class="AirBridge.ClipboardFiltersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipboard Filters" Height="400" Width="600"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen" 
        WindowStyle="None" AllowsTransparency="True" Topmost="True"
        MouseLeftButtonDown="Window_MouseDown">

    <Border Background="#1E1E1E" CornerRadius="12" BorderBrush="#3A3A3C" BorderThickness="1">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Clipboard Filters" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left"/>
                <Button Content="✕" Foreground="#A0A0A5" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Click="Close_Click" Cursor="Hand"/>
            </Grid>

            <TextBlock Grid.Row="1" Text="Ignore copied text matching these rules:" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <Border Grid.Row="2" BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="6" Background="#1C1C1E" Margin="0,0,0,10">
                <ListBox x:Name="FiltersList" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Type}" Foreground="#A0A0A5"/>
                                <TextBlock Grid.Column="1" Text="{Binding Keyword}" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Content="Delete" Foreground="#FF453A" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Delete_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Row="3" Background="#2C2C2E" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="TypeCombo" Grid.Column="0" Width="110" Height="28" Margin="0,0,10,0" SelectedIndex="0" Foreground="White">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1C1C1E"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3A3A3C"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="White"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="White"/>
                        </ComboBox.Resources>

                        <ComboBox.Template>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid>
                                    <ToggleButton x:Name="ToggleButton" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="#1C1C1E" BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="4">
                                                    <Path x:Name="Arrow" Fill="#A0A0A5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Data="M 0 0 L 4 4 L 8 0" Stroke="#A0A0A5" StrokeThickness="1"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="8,0,25,0" VerticalAlignment="Center" HorizontalAlignment="Left" />

                                    <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                        <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                            <Border x:Name="DropDownBorder" Background="#1C1C1E" BorderThickness="1" BorderBrush="#3A3A3C" CornerRadius="4"/>
                                            <ScrollViewer Margin="0,4,0,4" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                            </ScrollViewer>
                                        </Grid>
                                    </Popup>
                                </Grid>
                            </ControlTemplate>
                        </ComboBox.Template>

                        <ComboBoxItem Content="Starts With"/>
                        <ComboBoxItem Content="Ends With"/>
                        <ComboBoxItem Content="Contains"/>
                    </ComboBox>

                    <TextBox x:Name="KeywordInput" Grid.Column="1" Height="28" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="5,0" VerticalContentAlignment="Center"/>

                    <Button Grid.Column="2" Content="Add" Width="60" Height="28" Background="#3A3A3C" Foreground="White" BorderThickness="0" Margin="10,0,0,0" Click="Add_Click" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>