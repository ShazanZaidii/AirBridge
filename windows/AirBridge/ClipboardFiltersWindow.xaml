<Window x:Class="AirBridge.ClipboardFiltersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipboard Filters" Height="400" Width="600"
        Background="{StaticResource AB.Background}" WindowStartupLocation="CenterScreen" 
        Topmost="True">

    <Border Style="{StaticResource AB.Window.Card}">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Clipboard filters" Style="{StaticResource AB.Text.Title}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Button Content="{StaticResource AB.G.Close}" Style="{StaticResource AB.Button.Icon}" HorizontalAlignment="Right" Click="Close_Click"
                        ToolTip="Close" AutomationProperties.Name="Close" IsCancel="True"/>
            </Grid>

            <TextBlock Grid.Row="1" Text="Copied text matching these rules is never sent to other devices." Style="{StaticResource AB.Text.Caption}" Margin="2,0,0,10"/>

            <Border Grid.Row="2" BorderBrush="{StaticResource AB.Secondary}" BorderThickness="1" CornerRadius="10" Background="{StaticResource AB.Card}" Margin="0,0,0,10" Padding="4">
                <ListBox x:Name="FiltersList" Background="{StaticResource AB.Background}" BorderThickness="0" Foreground="#F8FAFC" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Type}" Foreground="#94A3B8"/>
                                <TextBlock Grid.Column="1" Text="{Binding Keyword}" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Content="&#xE74D;" Style="{StaticResource AB.Button.Icon}" Foreground="{StaticResource AB.Destructive}" Click="Delete_Click"
                                        ToolTip="Delete rule" AutomationProperties.Name="Delete rule"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Row="3" Background="{StaticResource AB.Card}" CornerRadius="10" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="TypeCombo" Grid.Column="0" Width="120" Height="36" AutomationProperties.Name="Rule type" Margin="0,0,10,0" SelectedIndex="0" Foreground="#F8FAFC">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0F172A"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#475569"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="White"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="White"/>
                        </ComboBox.Resources>

                        <ComboBox.Template>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid>
                                    <ToggleButton x:Name="ToggleButton" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="#0F172A" BorderBrush="#475569" BorderThickness="1" CornerRadius="8">
                                                    <Path x:Name="Arrow" Fill="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Data="M 0 0 L 4 4 L 8 0" Stroke="#94A3B8" StrokeThickness="1"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="8,0,25,0" VerticalAlignment="Center" HorizontalAlignment="Left" />

                                    <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Slide">
                                        <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                            <Border x:Name="DropDownBorder" Background="#0F172A" BorderThickness="1" BorderBrush="#475569" CornerRadius="8"/>
                                            <ScrollViewer Margin="0,4,0,4" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                            </ScrollViewer>
                                        </Grid>
                                    </Popup>
                                </Grid>
                            </ControlTemplate>
                        </ComboBox.Template>

                        <ComboBoxItem Content="Starts With"/>
                        <ComboBoxItem Content="Ends With"/>
                        <ComboBoxItem Content="Contains"/>
                    </ComboBox>

                    <TextBox x:Name="KeywordInput" Grid.Column="1" Style="{StaticResource AB.TextBox}" AutomationProperties.Name="Keyword"/>

                    <Button Grid.Column="2" Content="Add rule" Style="{StaticResource AB.Button.Primary}" Margin="10,0,0,0" Click="Add_Click" IsDefault="True"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>