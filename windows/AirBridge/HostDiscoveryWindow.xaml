<Window x:Class="AirBridge.HostDiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to Host" Height="400" Width="350"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen" 
        WindowStyle="None" AllowsTransparency="True" Topmost="True"
        MouseLeftButtonDown="Window_MouseDown">

    <Border Background="#1E1E1E" CornerRadius="16" BorderBrush="#3A3A3C" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Available Hosts" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Select a machine to link keyboards, mice, and clipboards." Foreground="#A0A0A5" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="HostsPanel">
                    <TextBlock x:Name="ScanningText" Text="Scanning network..." Foreground="#0A84FF" FontSize="13" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Content="Close" Height="30" Width="80" Background="Transparent" Foreground="#FF453A" BorderThickness="0" Click="Close_Click" Cursor="Hand" Margin="0,15,0,0"/>
        </Grid>
    </Border>
</Window>