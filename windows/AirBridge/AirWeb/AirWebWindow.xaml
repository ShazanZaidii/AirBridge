<Window x:Class="AirBridge.AirWeb.AirWebWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirWeb" Width="460" Height="780" MinWidth="380" MinHeight="420"
        Background="{StaticResource AB.Background}" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop">
    <ScrollViewer Style="{StaticResource AB.ScrollViewer}">
        <StackPanel Margin="20,16,20,20">

            <!-- header -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource AB.Text.Title}" Text="AirWeb"/>
                    <TextBlock Style="{StaticResource AB.Text.Caption}" Margin="0,2,0,0"
                               Text="Swap files with a phone or computer that doesn't have AirBridge, through its browser."/>
                </StackPanel>
                <Border Grid.Column="1" x:Name="StatusPill" CornerRadius="10" Padding="8,3" VerticalAlignment="Top" Margin="10,2,0,0" Background="{StaticResource AB.Card}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource AB.MutedForeground}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Style="{StaticResource AB.Text.Caption}" Margin="6,0,0,0" TextWrapping="NoWrap" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- invite -->
            <Border Background="{StaticResource AB.Card}" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource AB.Text.Section}" Text="Invite someone"/>
                    <Border x:Name="NoNetwork" Visibility="Collapsed" Padding="0,6">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AB.Text}" FontWeight="SemiBold" Text="Join a Wi-Fi network"/>
                            <TextBlock Style="{StaticResource AB.Text.Caption}" Margin="0,4,0,0"
                                       Text="Connect this PC to Wi-Fi or Ethernet (or turn on its Mobile Hotspot). The other device must be on the same network."/>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="InviteBody">
                        <Border Background="White" CornerRadius="12" Padding="10" HorizontalAlignment="Center" Margin="0,2,0,12">
                            <Image x:Name="QrImage" Width="196" Height="196" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   AutomationProperties.Name="QR code for the AirWeb link"/>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LinkBox" Style="{StaticResource AB.TextBox}" IsReadOnly="True" FontFamily="{StaticResource AB.MonoFont}" FontSize="12"
                                     AutomationProperties.Name="AirWeb link"/>
                            <Button Grid.Column="1" x:Name="CopyButton" Content="Copy" Style="{StaticResource AB.Button}" Margin="8,0,0,0" MinWidth="72" Click="Copy_Click"/>
                        </Grid>
                        <TextBlock Style="{StaticResource AB.Text.Caption}" Margin="0,10,0,0" TextAlignment="Center"
                                   Text="Scan this with a phone camera and open the link, or type it in any browser on the same Wi-Fi."/>

                        <Button x:Name="ShortToggle" Style="{StaticResource AB.Button.Link}" Click="ShortToggle_Click" Margin="0,8,0,0" HorizontalAlignment="Center"
                                AutomationProperties.Name="Need a short link?">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource AB.Text.Caption}" Text="Need a short link?" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock x:Name="ShortChevron" Style="{StaticResource AB.Glyph}" FontSize="10" Margin="6,1,0,0" Text="&#xE70D;"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Border x:Name="ShortBox" Visibility="Collapsed" Background="{StaticResource AB.Muted}" CornerRadius="12" Padding="14" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock x:Name="ShortUrl" Style="{StaticResource AB.Text}" FontFamily="{StaticResource AB.MonoFont}" FontSize="15" FontWeight="SemiBold"
                                           TextAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                                <TextBlock x:Name="ShortLeft" Style="{StaticResource AB.Text.Caption}" TextAlignment="Center" Margin="0,4,0,0"/>
                                <Button x:Name="ShortCopy" Content="Copy short link" Style="{StaticResource AB.Button.Secondary}" Margin="0,10,0,0" Click="ShortCopy_Click"/>
                                <Button x:Name="ShortNew" Content="Get a new short link" Style="{StaticResource AB.Button.Secondary}" Margin="0,10,0,0" Visibility="Collapsed" Click="ShortNew_Click"/>
                                <TextBlock Style="{StaticResource AB.Text.Caption}" TextAlignment="Center" Margin="0,10,0,0"
                                           Text="Type it in the other computer's browser. The full link above is still the one to trust."/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button x:Name="OtherAddress" Content="Use another address" Style="{StaticResource AB.Button.Link}" Click="OtherAddress_Click"/>
                            <Button Content="New link" Style="{StaticResource AB.Button.Link}" Click="NewLink_Click"
                                    ToolTip="Replace the link. Pages already open will show a message with the new one."/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- who is here -->
            <Border Background="{StaticResource AB.Card}" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource AB.Text.Section}" Text="Connected"/>
                    <TextBlock x:Name="PeersText" Style="{StaticResource AB.Text}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- shared by this PC -->
            <Border Background="{StaticResource AB.Card}" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource AB.Text.Section}" Text="Shared by this PC" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        <Button Grid.Column="1" Content="Add files" Style="{StaticResource AB.Button.Pill}" Click="AddFiles_Click"/>
                    </Grid>
                    <TextBlock x:Name="OfferedEmpty" Style="{StaticResource AB.Text.Caption}" Margin="2,0,0,0"
                               Text="Nothing added yet. Add files, or drop them anywhere on this window, and everyone connected can download them."/>
                    <StackPanel x:Name="OfferedList"/>
                </StackPanel>
            </Border>

            <!-- from browsers -->
            <Border Background="{StaticResource AB.Card}" CornerRadius="16" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource AB.Text.Section}" Text="From browsers"/>
                    <TextBlock x:Name="ReceivedEmpty" Style="{StaticResource AB.Text.Caption}" Margin="2,0,0,0"/>
                    <StackPanel x:Name="ReceivedList"/>
                </StackPanel>
            </Border>

            <Button Content="Stop AirWeb" Style="{StaticResource AB.Button.Primary}" Click="Stop_Click"/>
            <TextBlock Style="{StaticResource AB.Text.Caption}" TextAlignment="Center" Margin="0,8,0,0"
                       Text="AirWeb keeps running when you close this window. Stop it here, or from the AirBridge tray menu."/>
        </StackPanel>
    </ScrollViewer>
</Window>
