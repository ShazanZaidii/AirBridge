<Window x:Class="AirBridge.PairPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirBridge pairing request" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AB.Background}"
        Topmost="True" ShowInTaskbar="True" ResizeMode="NoResize">
    <Border Style="{StaticResource AB.Window.Card}">
        <StackPanel Margin="24">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AB.AccentSoft}">
                    <TextBlock Style="{StaticResource AB.Glyph}" Text="{StaticResource AB.G.Link}" Foreground="{StaticResource AB.Accent}" FontSize="18"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AB.Text.Title}" Text="Pairing request"/>
                    <TextBlock x:Name="WhoText" Style="{StaticResource AB.Text.Caption}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource AB.Card}" CornerRadius="12" Padding="16,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource AB.Text.Caption}" Text="Confirmation code" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DigitsText" Style="{StaticResource AB.Text.Digits}" Margin="0,4,0,0"
                               AutomationProperties.Name="Confirmation code"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="HintText" Style="{StaticResource AB.Text.Caption}" Margin="2,12,2,0"/>
            <TextBlock x:Name="ExpiryText" Style="{StaticResource AB.Text.Caption}" Margin="2,6,2,0"/>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="RejectButton" Content="_Reject" Style="{StaticResource AB.Button.Secondary}" IsCancel="True" Click="Reject_Click"/>
                <Button Grid.Column="2" x:Name="AcceptButton" Content="_Accept" Style="{StaticResource AB.Button.Primary}" Click="Accept_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
