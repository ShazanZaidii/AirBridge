<Window x:Class="AirBridge.SendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send via AirBridge" Height="420" Width="320"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        MouseLeftButtonDown="Window_MouseDown">
    <Border Background="#1E1E1E" CornerRadius="16" BorderBrush="#3A3A3C" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock x:Name="TitleText" Text="Send files" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SubtitleText" Text="Choose the devices to send to:" Foreground="#A0A0A5" FontSize="12"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,14"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DeviceList"/>
            </ScrollViewer>

            <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#FF9F0A" FontSize="12" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <Button x:Name="SendButton" Content="Send" Height="30" Width="90" Background="#0A84FF" Foreground="White"
                        BorderThickness="0" Click="Send_Click" Cursor="Hand" Margin="0,0,10,0"/>
                <Button x:Name="CancelButton" Content="Cancel" Height="30" Width="90" Background="Transparent" Foreground="#0A84FF"
                        BorderThickness="0" Click="Cancel_Click" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
