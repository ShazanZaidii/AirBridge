<Window x:Class="AirBridge.SendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send via AirBridge" Height="470" Width="360"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource AB.Background}" Topmost="True">
    <Border Style="{StaticResource AB.Window.Card}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock x:Name="TitleText" Style="{StaticResource AB.Text.Title}" Text="Send files" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource AB.Text.Caption}" Text="Click a device to send. Hold, or Ctrl+click, to choose several." Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel x:Name="DeviceList"/>
            </ScrollViewer>

            <!-- §10.1: bring up a Wi-Fi Direct link to the phone first, then send on it (falls back to the current connection). -->
            <StackPanel Grid.Row="2">
                <CheckBox x:Name="FastBox" Margin="4,8,4,0" Foreground="{StaticResource AB.Foreground}" Cursor="Hand"
                      VerticalContentAlignment="Center" IsEnabled="False"
                      ToolTip="Phones only: the PC hosts a Wi-Fi Direct network the phone joins for this transfer. Works without a shared Wi-Fi."
                      AutomationProperties.Name="Send fast over Wi-Fi Direct">
                <TextBlock Style="{StaticResource AB.Text}" Text="Send fast (Wi-Fi Direct)"/>
            </CheckBox>
                <!-- no AirBridge on the other device: through its browser -->
                <Button x:Name="AirWebButton" Style="{StaticResource AB.Button.Link}" HorizontalAlignment="Left" Margin="-2,6,0,0" Click="AirWeb_Click"
                        ToolTip="For a phone or computer without AirBridge: it opens a page in its browser to download these files"
                        AutomationProperties.Name="Send through AirWeb to any browser">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource AB.Glyph}" Text="&#xE774;" FontSize="12" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Style="{StaticResource AB.Text.Caption}" Text="Device without AirBridge? Use AirWeb" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Grid.Row="3" x:Name="StatusText" Style="{StaticResource AB.Text.Caption}" Foreground="{StaticResource AB.Warning}"
                       TextAlignment="Center" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>

            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource AB.Button.Secondary}" IsCancel="True" Click="Cancel_Click"/>
                <Button Grid.Column="2" x:Name="SendButton" Content="Send" Style="{StaticResource AB.Button.Primary}" IsDefault="True" Click="Send_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
