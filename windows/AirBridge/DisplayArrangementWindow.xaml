<Window x:Class="AirBridge.DisplayArrangementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arrange Displays" Height="480" Width="640"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen" 
        WindowStyle="None" AllowsTransparency="True" Topmost="True"
        MouseLeftButtonDown="Window_MouseDown">

    <Border Background="#1E1E1E" CornerRadius="12" BorderBrush="#3A3A3C" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Arrange Displays" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Button Content="✕" Foreground="#A0A0A5" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Click="Close_Click" Cursor="Hand"/>
            </Grid>

            <TextBlock Grid.Row="1" Text="Drag your phone to position it relative to your PC." Foreground="#A0A0A5" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Border Grid.Row="2" Background="#2C2C2E" CornerRadius="12" ClipToBounds="True" BorderBrush="#3A3A3C" BorderThickness="1">
                <Canvas x:Name="LayoutCanvas" Width="600" Height="360" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <Border x:Name="MacScreen" Width="400" Height="250" Background="#4285F4" CornerRadius="12" Canvas.Left="100" Canvas.Top="55">
                        <TextBlock Text="Windows PC" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Border x:Name="PhoneScreen" Width="70" Height="140" Background="#4ADE80" CornerRadius="12" Cursor="SizeAll"
                            MouseLeftButtonDown="Phone_MouseDown" MouseLeftButtonUp="Phone_MouseUp" MouseMove="Phone_MouseMove">
                        <TextBlock Text="Phone" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Canvas>
            </Border>
        </Grid>
    </Border>
</Window>