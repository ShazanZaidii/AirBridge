<Window x:Class="AirBridge.DisplayArrangementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arrange Displays" Width="760" SizeToContent="Height"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Topmost="True" ResizeMode="NoResize"
        FontFamily="Plus Jakarta Sans, Segoe UI Variable Text, Segoe UI" TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="Window_MouseDown">

    <!-- Palette: the design tokens (dark theme). No emoji icons: vector paths only. -->
    <Window.Resources>
        <Color x:Key="CBackground">#0F172A</Color>
        <Color x:Key="CCard">#1B2336</Color>
        <Color x:Key="CMuted">#272F42</Color>
        <Color x:Key="CSecondary">#334155</Color>
        <Color x:Key="CBorder">#475569</Color>
        <Color x:Key="CForeground">#F8FAFC</Color>
        <Color x:Key="CMutedForeground">#94A3B8</Color>
        <Color x:Key="CAccent">#22C55E</Color>
        <Color x:Key="COnAccent">#0F172A</Color>

        <SolidColorBrush x:Key="Background" Color="{StaticResource CBackground}"/>
        <SolidColorBrush x:Key="Card" Color="{StaticResource CCard}"/>
        <SolidColorBrush x:Key="Muted" Color="{StaticResource CMuted}"/>
        <SolidColorBrush x:Key="Secondary" Color="{StaticResource CSecondary}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource CBorder}"/>
        <SolidColorBrush x:Key="Foreground" Color="{StaticResource CForeground}"/>
        <SolidColorBrush x:Key="MutedForeground" Color="{StaticResource CMutedForeground}"/>
        <SolidColorBrush x:Key="Accent" Color="{StaticResource CAccent}"/>
        <SolidColorBrush x:Key="OnAccent" Color="{StaticResource COnAccent}"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Foreground}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedForeground}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Segmented choice (edge per device, push-through strength). Hover = overlay fade; checked = accent fill. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedForeground}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Fill" CornerRadius="6" BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource CMuted}"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{StaticResource CMuted}"/>
                                </Border.BorderBrush>
                            </Border>
                            <Border x:Name="Hover" CornerRadius="6" Background="White" Opacity="0"/>
                            <Border x:Name="Ring" CornerRadius="6" BorderBrush="White" BorderThickness="2" Opacity="0"/>
                            <ContentPresenter Margin="12,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Background.Color" To="{StaticResource CAccent}" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="BorderBrush.Color" To="{StaticResource CAccent}" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Background.Color" To="{StaticResource CMuted}" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="BorderBrush.Color" To="{StaticResource CMuted}" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Switch-style checkbox. -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Foreground}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="36" Height="20" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="10">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource CSecondary}"/>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="Ring" CornerRadius="10" BorderBrush="White" BorderThickness="2" Margin="-3" Opacity="0"/>
                                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{StaticResource Foreground}" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Background.Color" To="{StaticResource CAccent}" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="RenderTransform.X" To="16" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Background.Color" To="{StaticResource CSecondary}" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="RenderTransform.X" To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="32" Height="32">
                            <Border x:Name="Hover" CornerRadius="8" Background="White" Opacity="0"/>
                            <Border x:Name="Ring" CornerRadius="8" BorderBrush="White" BorderThickness="2" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Background}" CornerRadius="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="Arrange displays" Foreground="{StaticResource Foreground}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="Each outer edge controls at most one device. Push the cursor firmly past that edge to cross; touching it does nothing."/>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click"
                        AutomationProperties.Name="Close" ToolTip="Close">
                    <!-- Lucide "x" -->
                    <Path Data="M18,6 L6,18 M6,6 L18,18" Stroke="{StaticResource MutedForeground}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
            </Grid>

            <!-- Lease state -->
            <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="10" Padding="12,8" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="LeaseDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource MutedForeground}"/>
                    <TextBlock x:Name="LeaseText" Margin="10,0,0,0" Foreground="{StaticResource Foreground}" FontSize="13" VerticalAlignment="Center"
                               Text="Not controlling or being controlled"/>
                </StackPanel>
            </Border>

            <!-- Desktop layout -->
            <StackPanel Grid.Row="2">
                <Border Background="{StaticResource Card}" CornerRadius="12" ClipToBounds="True">
                    <Canvas x:Name="LayoutCanvas" Width="710" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"/>
                </Border>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="Drag a device tile onto an edge of your desktop. Scroll over a tile to change how much of the edge it uses."/>
            </StackPanel>

            <!-- Edges + crossing settings -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource Card}" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Edges"/>
                        <StackPanel x:Name="EdgeRows"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource Card}" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Crossing"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Push-through strength" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="StrengthEasy" Style="{StaticResource Segment}" GroupName="Strength" Content="Easy" Checked="Strength_Checked" Tag="easy"/>
                            <RadioButton x:Name="StrengthNormal" Style="{StaticResource Segment}" GroupName="Strength" Content="Normal" Checked="Strength_Checked" Tag="normal"/>
                            <RadioButton x:Name="StrengthFirm" Style="{StaticResource Segment}" GroupName="Strength" Content="Firm" Checked="Strength_Checked" Tag="firm"/>
                        </StackPanel>
                        <TextBlock x:Name="StrengthHint" Style="{StaticResource Hint}" Margin="0,6,0,12"/>
                        <CheckBox x:Name="RequireAlt" Style="{StaticResource Switch}" Content="Also hold Alt to cross"
                                  Checked="RequireAlt_Changed" Unchecked="RequireAlt_Changed"/>
                        <CheckBox x:Name="SwapCmdCtrl" Style="{StaticResource Switch}" Margin="0,12,0,0"
                                  Checked="SwapCmdCtrl_Changed" Unchecked="SwapCmdCtrl_Changed">
                            <TextBlock TextWrapping="Wrap" Text="When a Mac controls this PC, use Cmd as Ctrl (and Ctrl as Win)"/>
                        </CheckBox>
                        <TextBlock Style="{StaticResource Hint}" Text="Edge glow" Margin="0,16,0,8"/>
                        <WrapPanel x:Name="EdgeSwatches"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBox x:Name="EdgeHex" Width="92" MaxLength="7" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="Edge glow colour as a hex code"
                                     LostFocus="EdgeHex_Commit" KeyDown="EdgeHex_KeyDown"/>
                            <Button x:Name="EdgeReset" Content="Reset" Style="{StaticResource AB.Button.Ghost}" Margin="8,0,0,0" Click="EdgeReset_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Devices -->
            <Border Grid.Row="4" Background="{StaticResource Card}" CornerRadius="12" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Devices"/>
                    <StackPanel x:Name="PeerRows"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="5" Style="{StaticResource Hint}" Margin="0,12,0,0"
                       Text="While controlling another device, press Ctrl+Alt+Esc to bring the cursor back to this PC."/>
        </Grid>
    </Border>
</Window>
