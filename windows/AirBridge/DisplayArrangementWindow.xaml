<Window x:Class="AirBridge.DisplayArrangementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display Arrangement" Height="360" Width="400"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen" 
        WindowStyle="None" AllowsTransparency="True" Topmost="True"
        MouseLeftButtonDown="Window_MouseDown">

    <Border Background="#1E1E1E" CornerRadius="12" BorderBrush="#3A3A3C" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Display Arrangement" Foreground="White" FontSize="14" FontWeight="Bold"/>
                <Button Content="✕" Foreground="#A0A0A5" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Click="Close_Click" Cursor="Hand"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Target Edge:" Foreground="#A0A0A5" FontSize="12" Margin="0,0,0,5"/>
                <ComboBox x:Name="EdgeCombo" Width="150" HorizontalAlignment="Left" SelectionChanged="EdgeCombo_SelectionChanged" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C">
                    <ComboBox.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1C1C1E"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3A3A3C"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="White"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="White"/>
                    </ComboBox.Resources>
                    <ComboBoxItem Content="Left"/>
                    <ComboBoxItem Content="Right"/>
                    <ComboBoxItem Content="Top"/>
                    <ComboBoxItem Content="Bottom"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="Relative Position (Offset):" Foreground="#A0A0A5" FontSize="12" Margin="0,0,0,5"/>
                <Slider x:Name="OffsetSlider" Minimum="0" Maximum="1" Value="0.25" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,15">
                <TextBlock Text="Intersection Size (% of screen edge):" Foreground="#A0A0A5" FontSize="12" Margin="0,0,0,5"/>
                <Slider x:Name="SizeSlider" Minimum="0.1" Maximum="1" Value="0.5" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
            </StackPanel>

            <Button Grid.Row="4" Content="Save Configuration" Height="30" Background="#0A84FF" Foreground="White" BorderThickness="0" VerticalAlignment="Bottom" Click="Save_Click" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>