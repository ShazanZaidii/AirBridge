<Window x:Class="AirBridge.DisplayArrangementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arrange Displays" Width="720" SizeToContent="Height"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Topmost="True" ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseDown">

    <Border Background="#1E1E1E" CornerRadius="12" BorderBrush="#3A3A3C" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Arrange Displays" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Button Content="✕" Foreground="#A0A0A5" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Click="Close_Click" Cursor="Hand"/>
            </Grid>

            <TextBlock Grid.Row="1" TextWrapping="Wrap" TextAlignment="Center" Foreground="#A0A0A5" FontSize="13" Margin="0,0,0,12"
                       Text="Drag a device onto an outer edge of your desktop. Scroll over a device to change how much of the edge it uses."/>

            <Border Grid.Row="2" Background="#2C2C2E" CornerRadius="12" ClipToBounds="True" BorderBrush="#3A3A3C" BorderThickness="1">
                <Canvas x:Name="LayoutCanvas" Width="660" Height="320" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"/>
            </Border>

            <StackPanel Grid.Row="3" x:Name="PeerRows" Margin="0,14,0,0"/>

            <CheckBox Grid.Row="4" x:Name="SwapCmdCtrl" Margin="0,12,0,0" Foreground="#D0D0D5" FontSize="13"
                      Content="When a Mac controls this PC, use ⌘ Cmd as Ctrl (and Ctrl as Win)"
                      Checked="SwapCmdCtrl_Changed" Unchecked="SwapCmdCtrl_Changed"/>

            <TextBlock Grid.Row="5" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#8E8E93" FontSize="12"
                       Text="While controlling another device, press Ctrl+Alt+Esc to bring the cursor back to this PC."/>
        </Grid>
    </Border>
</Window>
