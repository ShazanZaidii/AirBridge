<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Pairing keys and the device id must never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="airbridge_pairs.xml" />
        <exclude domain="sharedpref" path="airbridge_identity.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="airbridge_pairs.xml" />
        <exclude domain="sharedpref" path="airbridge_identity.xml" />
    </device-transfer>
</data-extraction-rules>
