<resources>
    <string name="accessibility_service_description">পেয়ার করা কম্পিউটারকে এই ফোন নিয়ন্ত্রণ করতে দেয়: মাউস ফোনে এলে কার্সর দেখায়, ট্যাপ, টেনে আনা, স্ক্রল এবং সিস্টেমের কাজ (হোম, ফিরে যান, সাম্প্রতিক, ভলিউম, মিডিয়া) করে। এই পরিষেবা আপনার স্ক্রিনে কী আছে তা পড়তে পারে না। কম্পিউটার থেকে টাইপ করতে আলাদা, ঐচ্ছিক \"এয়ারব্রিজ টাইপিং ও ক্লিপবোর্ড\" পরিষেবা লাগে।</string>
    <string name="text_service_description">ঐচ্ছিক। পেয়ার করা কম্পিউটারকে আপনার ব্যবহার করা টেক্সট ফিল্ডে টাইপ করতে দেয় (এবং Enter, Backspace, Tab, তীরচিহ্ন, কপি, কাট, পেস্ট ও সব বেছে নেওয়া), আর আপনি কপি করলে তা টের পায় যাতে টেক্সট নিজে থেকেই আপনার কম্পিউটারে যায়। এর জন্য এটি ফোকাস করা টেক্সট ফিল্ড এবং আপনি যে বোতামে ট্যাপ করেন তার লেবেল (যেমন \"কপি\") পড়তে পারে, আর কীবোর্ডের মতো টাইপ করে। এয়ারব্রিজ স্ক্রিনের কিছু সেভ বা আপলোড করে না; শুধু আপনার ক্লিপবোর্ড আপনার নিজের পেয়ার করা ডিভাইসে যায়। ব্যাঙ্কিং ও UPI অ্যাপ স্ক্রিন পড়তে পারে এমন অ্যাক্সেসিবিলিটি পরিষেবা নিয়ে সতর্ক করতে পারে: পেমেন্টের সময় এটি বন্ধ রাখুন। এটি ছাড়াও রিমোট কন্ট্রোল চলে।</string>
    <string name="a11y_core_title">কম্পিউটার থেকে নিয়ন্ত্রণ করুন</string>
    <string name="a11y_core_sub">আবশ্যক। \"%1$s\" কার্সর দেখায়, ট্যাপ ও স্ক্রল করে, আর ফিরে যান, হোম ও ভলিউম চালায়। এটি আপনার স্ক্রিন পড়তে পারে না।</string>
    <string name="tp_on_cap">চালু</string>
    <string name="a11y_text_title">টাইপিং ও ক্লিপবোর্ড (ঐচ্ছিক) · %1$s</string>
    <string name="tp_off_cap">বন্ধ</string>
    <string name="a11y_text_body">\"%1$s\" আপনি যে টেক্সট ফিল্ডে টাইপ করছেন তা পড়তে পারে, যাতে কম্পিউটার সেখানে টাইপ, কপি ও পেস্ট করতে পারে, আর আপনি কপি করলে টেক্সট নিজে থেকেই পাঠানো হয়। ব্যাঙ্কিং ও UPI অ্যাপ স্ক্রিন পড়া অ্যাক্সেসিবিলিটি পরিষেবা নিয়ে সতর্ক করতে পারে: পেমেন্টের সময় এটি বন্ধ রাখুন। এটি ছাড়াও রিমোট কন্ট্রোল চলে এবং বাবল আপনার ক্লিপবোর্ড পাঠায়।</string>
    <string name="a11y_keepalive_vivo">পরিষেবা বারবার বন্ধ হয়ে যাচ্ছে? vivo / iQOO ফোনে সিস্টেম ব্যাকগ্রাউন্ডের অ্যাপ বন্ধ করে দেয়, তারপর Android তাদের অ্যাক্সেসিবিলিটি পরিষেবা বন্ধ করে। সেটিংস › ব্যাটারি › ব্যাকগ্রাউন্ড পাওয়ার ব্যবহার ম্যানেজমেন্টে এয়ারব্রিজকে বেশি ব্যাকগ্রাউন্ড পাওয়ার ব্যবহারের অনুমতি দিন, আর সাম্প্রতিক-এ এয়ারব্রিজ লক করুন (কার্ডটি নিচে সোয়াইপ করুন বা লকে ট্যাপ করুন)। OriginOS / Funtouch-এর সংস্করণ অনুযায়ী মেনুর নাম আলাদা হতে পারে।</string>
    <string name="a11y_keepalive">পরিষেবা বারবার বন্ধ হয়ে যাচ্ছে? কিছু ফোন ব্যাকগ্রাউন্ডের অ্যাপ বন্ধ করে দেয়, তারপর Android তাদের অ্যাক্সেসিবিলিটি পরিষেবা বন্ধ করে। এয়ারব্রিজের ব্যাটারি ব্যবহার \'অসীমিত\' করুন এবং ফোনে সুবিধা থাকলে সাম্প্রতিক-এ এটি লক করুন।</string>
